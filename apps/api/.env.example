# Copy to apps/api/.env. Every value below has a working default, so the file
# only needs editing if the pack lives somewhere unusual.
#
# Relative paths resolve against apps/api/, not against your shell's current
# directory, so `uv run` works from anywhere in the repo.

# --- Databases -------------------------------------------------------------
# Three, and only the first has to exist before you start.

# 1. The assignment pack. Opened read-only and never written to. Not in git —
#    unzip the pack inside the repo root, or put an absolute path here.
KESTREL_DB_PATH=../../FDE_Assignment_Pack_Kestrel_v1.1/data/kestrel_ops.db

# 2. Cases ticked off on the morning screen. Created on the first tick. Kept
#    apart from the pack because the pack must stay read-only.
HANDLED_DB_PATH=data/handled.db

# 3. Competitor shelf prices, written by `uv run python -m app.bazaarpulse`.
#    Missing until you run that, and the screen says so instead of breaking.
BAZAARPULSE_DB_PATH=data/bazaarpulse.db

# --- Everything else -------------------------------------------------------

# Where the BazaarPulse site is being served while you scrape it.
BAZAARPULSE_BASE_URL=http://localhost:8080

# Which morning the screen opens on. The pack is frozen, so "today" cannot come
# from the clock. Unset means the last day that has data; set a date to replay
# a past morning.
# AS_OF_DATE=2026-04-14

# Browsers allowed to call this API. Comma-separated.
CORS_ORIGINS=http://localhost:3000
